rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function film(id) {
      return id in ['sFw17ZPE42A','F-MEc4hmxJU','6Wdj9n3Pq9Q','bDqEJXYr2dY','vrVGZ_HMxQs','dGnjxL64HHY','WZ0ozLABZwE','l2G5ITnriFQ','4f6Zguf7c2M','BY0ZT5SK8qY','hoFQL2ON9m4','6CCZA8el6Mk','gTdqOtFvcDM','HP-B3jZLs3w','NV9PeKvKv7c','y4t5NDVqPyU','pBti3GK2nkc','j95SyBMQiNI','VCd4T8sLFjg','OLSjUGODAeE','L53hio-gtv0','Byh-aCKSDgo','UxrkaAvtsNI','iVwqj1gUPDY'];
    }
    function previousReaction(id) {
      let path = /databases/$(database)/documents/filmStats/$(id)/reactions/$(request.auth.uid);
      return exists(path) ? get(path).data : {'liked':false, 'viewedAt':timestamp.date(1970,1,1)};
    }
    function previousStats(id) {
      let path = /databases/$(database)/documents/filmStats/$(id);
      return exists(path) ? get(path).data : {'views':0, 'likes':0};
    }
    function validChange(id) {
      let before = previousReaction(id);
      let after = getAfter(/databases/$(database)/documents/filmStats/$(id)/reactions/$(request.auth.uid)).data;
      let old = previousStats(id);
      let next = getAfter(/databases/$(database)/documents/filmStats/$(id)).data;
      let viewing = after.viewedAt != before.viewedAt;
      let liking = after.liked != before.liked;
      return after.keys().hasOnly(['liked','viewedAt'])
        && after.liked is bool && after.viewedAt is timestamp
        && ((viewing && !liking && after.viewedAt == request.time
             && request.time >= before.viewedAt + duration.value(24, 'h'))
            || (liking && !viewing))
        && next.keys().hasOnly(['views','likes','updatedAt'])
        && next.views is int && next.likes is int
        && next.views == old.views + (viewing ? 1 : 0)
        && next.likes == old.likes + (after.liked ? 1 : 0) - (before.liked ? 1 : 0)
        && next.likes >= 0 && next.views >= 0 && next.updatedAt == request.time;
    }
    // Private study corpus: verified Google owner only; no anonymous/list access.
    function libraryOwner() {
      return request.auth != null
        && request.auth.token.keys().hasAll(['email','email_verified'])
        && request.auth.token.email == 'guletlaru05@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /privateLibrary/{id} {
      allow get: if id == 'main' && libraryOwner();
      allow list, delete: if false;
      allow create, update: if id == 'main' && libraryOwner()
        && request.resource.data.keys().hasOnly(['payload','updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 750000
        && request.resource.data.updatedAt == request.time;
    }
    // Public nickname board. Owner-only answers and recoverable moderation.
    function validPost(d) {
      return d.keys().hasAll(['nickname','title','body','topic','authorUid','official','answer','answeredAt','createdAt','updatedAt'])
        && d.keys().hasOnly(['nickname','title','body','topic','authorUid','official','answer','answeredAt','createdAt','updatedAt'])
        && d.nickname is string && d.nickname.size() >= 2 && d.nickname.size() <= 24
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 120
        && d.body is string && d.body.size() >= 10 && d.body.size() <= 3000
        && d.topic in ['story','making','character','other']
        && d.authorUid is string && d.authorUid.size() > 0 && d.authorUid.size() <= 128
        && d.official is bool && d.answer is string && d.answer.size() <= 5000
        && d.createdAt is timestamp && d.createdAt <= request.time && d.updatedAt == request.time
        && ((d.answer == '' && d.answeredAt == null)
            || (d.answer.size() >= 2 && d.answeredAt is timestamp
                && d.answeredAt >= d.createdAt && d.answeredAt <= request.time));
    }
    function mayPost() {
      let rate = /databases/$(database)/documents/communityLimits/$(request.auth.uid);
      return !exists(rate) || request.time >= get(rate).data.lastAt + duration.value(10,'m');
    }
    match /communityPosts/{id} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 10;
      allow create: if signedIn() && validPost(request.resource.data)
        && (( !libraryOwner()
              && request.resource.data.authorUid == request.auth.uid
              && request.resource.data.official == false
              && request.resource.data.answer == '' && request.resource.data.answeredAt == null
              && request.resource.data.createdAt == request.time && mayPost()
              && getAfter(/databases/$(database)/documents/communityLimits/$(request.auth.uid)).data.lastPostId == id
              && getAfter(/databases/$(database)/documents/communityLimits/$(request.auth.uid)).data.lastAt == request.time)
            || (libraryOwner()
              && ((request.resource.data.official == true
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.nickname == 'DRA9ON CINEMA'
                    && request.resource.data.createdAt == request.time)
                  || (exists(/databases/$(database)/documents/communityArchive/$(id))
                    && get(/databases/$(database)/documents/communityArchive/$(id)).data.state == 'hidden'
                    && request.resource.data.diff(get(/databases/$(database)/documents/communityArchive/$(id)).data.post).affectedKeys().hasOnly(['updatedAt'])
                    && getAfter(/databases/$(database)/documents/communityArchive/$(id)).data.state == 'restored'))));
      allow update: if libraryOwner() && validPost(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','answeredAt','updatedAt'])
        && request.resource.data.answer.size() >= 2 && request.resource.data.answeredAt == request.time;
      // Removal requires an exact owner-only archived copy in the same batch.
      allow delete: if libraryOwner()
        && getAfter(/databases/$(database)/documents/communityArchive/$(id)).data.post == resource.data
        && getAfter(/databases/$(database)/documents/communityArchive/$(id)).data.state == 'hidden';
    }
    match /communityLimits/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && !libraryOwner() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['lastAt','lastPostId'])
        && request.resource.data.keys().hasOnly(['lastAt','lastPostId'])
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastPostId is string && request.resource.data.lastPostId.size() <= 128
        && mayPost()
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.lastPostId)).data.authorUid == uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(request.resource.data.lastPostId)).data.createdAt == request.time;
    }
    match /communityArchive/{id} {
      allow get: if libraryOwner();
      allow list: if libraryOwner() && request.query.limit != null && request.query.limit <= 20;
      allow create: if libraryOwner()
        && request.resource.data.keys().hasAll(['post','archivedAt','state'])
        && request.resource.data.keys().hasOnly(['post','archivedAt','state'])
        && request.resource.data.post == get(/databases/$(database)/documents/communityPosts/$(id)).data
        && request.resource.data.archivedAt == request.time && request.resource.data.state == 'hidden'
        && !existsAfter(/databases/$(database)/documents/communityPosts/$(id));
      allow update: if libraryOwner()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
              && resource.data.state == 'hidden' && request.resource.data.state == 'restored'
              && getAfter(/databases/$(database)/documents/communityPosts/$(id)).data.diff(resource.data.post).affectedKeys().hasOnly(['updatedAt']))
            || (request.resource.data.keys().hasAll(['post','archivedAt','state'])
              && request.resource.data.keys().hasOnly(['post','archivedAt','state'])
              && request.resource.data.post == get(/databases/$(database)/documents/communityPosts/$(id)).data
              && request.resource.data.archivedAt == request.time && request.resource.data.state == 'hidden'
              && !existsAfter(/databases/$(database)/documents/communityPosts/$(id))));
      allow delete: if false;
    }
    match /filmStats/{id} {
      allow get: if film(id);
      allow list, delete: if false;
      allow create, update: if film(id) && signedIn() && validChange(id);
      match /reactions/{uid} {
        allow get: if film(id) && signedIn() && request.auth.uid == uid;
        allow list, delete: if false;
        allow create, update: if film(id) && signedIn() && request.auth.uid == uid && validChange(id);
      }
    }
    // Insert inside match /databases/{database}/documents, preserving live rules.
    // Counts are consenting browser-days, not verified people or GA4 users.
    function siteVisitDay() {
      return int((request.time.toMillis() + 32400000) / 86400000);
    }
    // The affected document uses resource/request.resource without access calls.
    // Only the other two documents need exists/get/getAfter: at most 6 per write,
    // or 18 for all three writes, even without the Rules access-call cache.
    function validSiteVisit(kind) {
      let day = siteVisitDay();
      let summaryPath = /databases/$(database)/documents/siteVisits/summary;
      let dayPath = /databases/$(database)/documents/siteVisitDays/$(string(day));
      let browserPath = /databases/$(database)/documents/siteVisitBrowsers/$(request.auth.uid);
      let oldSummary = kind == 'summary'
        ? (request.method == 'create' ? {'total':0, 'startedAt':request.time} : resource.data)
        : (exists(summaryPath) ? get(summaryPath).data : {'total':0, 'startedAt':request.time});
      let oldDay = kind == 'day'
        ? (request.method == 'create' ? {'visits':0} : resource.data)
        : (exists(dayPath) ? get(dayPath).data : {'visits':0});
      let oldBrowser = kind == 'browser'
        ? (request.method == 'create' ? {'day':-1} : resource.data)
        : (exists(browserPath) ? get(browserPath).data : {'day':-1});
      let summary = kind == 'summary' ? request.resource.data : getAfter(summaryPath).data;
      let daily = kind == 'day' ? request.resource.data : getAfter(dayPath).data;
      let browser = kind == 'browser' ? request.resource.data : getAfter(browserPath).data;
      return oldBrowser.day < day
        && summary.keys().hasAll(['total','startedAt','updatedAt'])
        && summary.keys().hasOnly(['total','startedAt','updatedAt'])
        && summary.total is int && summary.total == oldSummary.total + 1
        && summary.total > 0 && summary.startedAt is timestamp
        && summary.startedAt == oldSummary.startedAt
        && summary.updatedAt == request.time
        && daily.keys().hasAll(['day','visits','updatedAt'])
        && daily.keys().hasOnly(['day','visits','updatedAt'])
        && daily.day is int && daily.day == day
        && daily.visits is int && daily.visits == oldDay.visits + 1
        && daily.visits > 0 && daily.visits <= summary.total
        && daily.updatedAt == request.time
        && browser.keys().hasAll(['day','visitedAt'])
        && browser.keys().hasOnly(['day','visitedAt'])
        && browser.day is int && browser.day == day
        && browser.visitedAt == request.time;
    }
    match /siteVisits/{id} {
      allow get: if id == 'summary' && libraryOwner();
      allow list, delete: if false;
      allow create, update: if false; // Retired browser-identity visit collection.
    }
    match /siteVisitDays/{id} {
      allow get: if id.matches('^[0-9]{1,8}$') && libraryOwner();
      allow list, delete: if false;
      allow create, update: if false;
    }
    match /siteVisitBrowsers/{uid} {
      allow get: if libraryOwner();
      allow list, delete: if false;
      allow create, update: if false;
    }
  }
}
